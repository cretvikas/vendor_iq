# Backend settings
DATABASE_URL=sqlite:///./vendor_iq.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
VERIFICATION_MODE=demo
# Optional server-side demo fixture: comma-separated tax IDs that simulate a trusted-provider rejection.
DEMO_BLOCKED_TAX_IDS=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: enables OpenAI-assisted document extraction. Decisions remain rule-based.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
